# ─── ASSET STORAGE & CDN ──────────────────────────────────────────────────────
# Default: local fallback from /public/assets
# For cloud storage (Google Cloud Storage or CloudFront), set NEXT_PUBLIC_CDN_URL
# Example: https://storage.googleapis.com/my-bucket
# Example: https://d12345.cloudfront.net
NEXT_PUBLIC_CDN_URL=

# Canonical public site URL (used for metadata, sitemap, Open Graph, schema)
NEXT_PUBLIC_SITE_URL=https://bradleyinnovations.group

# Storage configuration (used by sync:assets script)
STORAGE_TYPE=local
STORAGE_BUCKET_NAME=
STORAGE_PATH_PREFIX=

# For GCS configuration (optional, only needed when STORAGE_TYPE=gcs):
# GCS_PROJECT_ID=your-project-id
# GCS_SERVICE_ACCOUNT_KEY_PATH=./path/to/service-account-key.json
